{
  "manifest_version": 2,
  "name": "Reading Heatmap",
  "version": "0.5.1",
  "description": "Track your reading activity in Zotero and visualize it as a GitHub-style heatmap. Monthly view, group sync, and Zotero Style data import.",
  "author": "Manus AI",
  "homepage_url": "https://github.com/zotero-reading-heatmap",
  "icons": {
    "48": "chrome/content/icons/favicon.png",
    "96": "chrome/content/icons/favicon.png"
  },
  "applications": {
    "zotero": {
      "id": "reading-heatmap@zotero-plugin.com",
      "update_url": "https://github.com/zotero-reading-heatmap/releases",
      "strict_min_version": "6.999",
      "strict_max_version": "9.99.99"
    }
  }
}
